            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anker Soundcore Space One\",\n  \"sku\": \"ELEC-ANK-909\",\n  \"description\": \"Noise cancelling wireless headphones with 40H battery life.\",\n  \"category\": \"Electronics\",\n  \"price\": 99.99,\n  \"quantityInStock\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
