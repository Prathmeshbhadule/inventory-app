{
  "info": {
    "_postman_id": "a9041cb1-e8d7-4632-a50d-d4e5f6172839",
    "name": "InventoryHub MongoDB & Express API",
    "description": "Complete Postman collection for testing the Node.js + Express + MongoDB CRUD API including User Registration and Product Inventory.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
