# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Connection String
# Option A: Local MongoDB instance
# MONGO_URI=mongodb://127.0.0.1:27017/inventory_db

# Option B: MongoDB Atlas (Cloud) - Replace with your credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/inventory_db?retryWrites=true&w=majority
